APP_NAME="أراكاري"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aracari
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@aracari.com"
MAIL_FROM_NAME="${APP_NAME}"

# Currency Settings
CURRENCY_CACHE_DURATION=3600
DEFAULT_CURRENCY=YER
BASE_CURRENCY=YER

# Firebase Settings (for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=

# SMS Gateway Settings
SMS_GATEWAY_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=Aracari

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM_NUMBER=

# Vonage Configuration (alternative to Twilio)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=

# File Upload Settings
MAX_FILE_SIZE=10240
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Security Settings
MAINTENANCE_BYPASS=false
MAINTENANCE_BYPASS_IPS=127.0.0.1
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_MINUTES=1

# API Settings
API_RATE_LIMIT=1000
API_THROTTLE_REQUESTS=60
API_THROTTLE_MINUTES=1

# Payment Gateway (Future)
PAYMENT_GATEWAY=stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
